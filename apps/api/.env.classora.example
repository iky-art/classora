# Tambahkan/ubah nilai berikut pada .env hasil `composer create-project` (atau jalankan php artisan classora:install)
APP_URL=http://localhost:8000
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=classora
DB_USERNAME=classora
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false   # set true di produksi (HTTPS)
SANCTUM_STATEFUL_DOMAINS=localhost:5173
